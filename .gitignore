# Python / uv
__pycache__/
*.py[cod]
.venv/
.uv/
dist/
build/
*.egg-info/

# Environment and secrets
.env
.env.*
!.env.example

# Local data: never commit. The database is the history this tool exists to keep,
# and git handles binary files badly enough to corrupt it.
*.db
*.db-wal
*.db-shm
data/
photos/
exports/
# A saved search is a hand-written file rather than collected data, but it is still the user's:
# its areas are a fairly precise picture of where somebody is looking to live. The workspace is
# meant to sit outside the checkout; this is here so that running from inside one cannot quietly
# commit that.
searches/
# The same, for the lock a run holds while it is going: it belongs to a workspace, not to a
# checkout, and it is litter here rather than anything worth keeping.
runs/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Exports are collected listing data, which never goes in git. The directory is one place they land;
# these two patterns are the rest, because `homescout export --to` will write wherever it is told.
*.xlsx
*.csv
!tests/fixtures/**/*.csv
