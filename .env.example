# HomeScout settings that hold a secret, or that a scheduled task needs.
#
# Copy this to `.env` beside your database and fill in what you use. `.env` is never committed:
# it is in `.gitignore`, and nothing in this tool will read a credential from a saved search, a
# committed file, or a command-line argument.
#
# Every value here can also be set as an ordinary environment variable, which wins over this file.

# Where the database lives. Set this absolutely if you run on a schedule: a scheduled task does not
# start in your project folder, and this is what everything else is found relative to.
HOMESCOUT_DB=

# Where `run --deliver` writes the digest. Defaults to digest.json beside the database.
HOMESCOUT_DIGEST_PATH=

# The mail account for the email digest. Optional: with none of these set, HomeScout runs normally
# and sends nothing. Set all of HOST, FROM and TO, or none of them.
HOMESCOUT_SMTP_HOST=
HOMESCOUT_SMTP_PORT=
# starttls (default), ssl, or none. The certificate is verified, and there is no fallback: if
# encryption was asked for and the server does not offer it, nothing is sent.
HOMESCOUT_SMTP_SECURITY=
HOMESCOUT_SMTP_USERNAME=
# Use an app password wherever your provider offers one.
HOMESCOUT_SMTP_PASSWORD=
HOMESCOUT_MAIL_FROM=
HOMESCOUT_MAIL_TO=

# How many new properties one email lists before the rest become a count. Default 25.
HOMESCOUT_EMAIL_MAX_NEW=

# Enrichment. Only needed to turn on the broadband provider, which the FCC now requires a key for.
HOMESCOUT_FCC_TOKEN=
