# HomeScout settings that hold a secret, or that a scheduled task needs.
#
# Copy this to `.env` beside your database and fill in what you use. `.env` is never committed:
# it is in `.gitignore`, and nothing in this tool will read a credential from a saved search, a
# committed file, or a command-line argument.
#
# Every value here can also be set as an ordinary environment variable, which wins over this file.

# Where the database lives. Set this absolutely if you run on a schedule: a scheduled task does not
# start in your project folder, and this is what everything else is found relative to.
HOMESCOUT_DB=

# Where `run --deliver` writes the digest. Defaults to digest.json beside the database.
HOMESCOUT_DIGEST_PATH=

# The mail account for the email digest. Optional: with none of these set, HomeScout runs normally
# and sends nothing. Set all of HOST, FROM and TO, or none of them.
HOMESCOUT_SMTP_HOST=
HOMESCOUT_SMTP_PORT=
# starttls (default), ssl, or none. The certificate is verified, and there is no fallback: if
# encryption was asked for and the server does not offer it, nothing is sent.
HOMESCOUT_SMTP_SECURITY=
HOMESCOUT_SMTP_USERNAME=
# Use an app password wherever your provider offers one.
HOMESCOUT_SMTP_PASSWORD=
HOMESCOUT_MAIL_FROM=
HOMESCOUT_MAIL_TO=

# How many new properties one email lists before the rest become a count. Default 25.
HOMESCOUT_EMAIL_MAX_NEW=

# Enrichment. Only needed to turn on the broadband provider, which the FCC requires an account for.
# Two values, not one: the email you registered with and the key under your account. Free, at
# https://broadbandmap.fcc.gov/login. Then `homescout broadband --state XX` once per state, because
# the FCC publishes files rather than answering about one address.
HOMESCOUT_FCC_USERNAME=
HOMESCOUT_FCC_TOKEN=

# ---------------------------------------------------------------------------
# Description field extraction, the optional model pass
# ---------------------------------------------------------------------------
# Everything below is optional. With none of it set, the six extracted fields (water source, sewer,
# heating, cooling, gas, roof) are still filled from listing prose by the deterministic patterns,
# which need no key, no address and no network. This only adds a model for the descriptions those
# patterns could not settle, and only for saved searches that ask for one with `extract: {model: true}`.

# Where the OpenAI-compatible server is. Defaults to https://api.openai.com/v1.
# For a local one, LM Studio's default is http://localhost:1234/v1 and needs no credential.
HOMESCOUT_EXTRACT_BASE_URL=

# Which model to ask. Required when a saved search turns the pass on. For a hosted service that is
# something like gpt-4o-mini; for a local server it is whatever that server calls what it has loaded.
HOMESCOUT_EXTRACT_MODEL=

# How hard a reasoning model thinks before answering: none, low, medium, high or xhigh. Leave it
# empty for a model that does not reason, which is most local ones. Reading a description is
# transcription rather than judgment, so low is plenty and none is often enough.
HOMESCOUT_EXTRACT_REASONING_EFFORT=

# The credential. Only required when the address is not on this machine. OPENAI_API_KEY is read as a
# fallback, so an installation that already has one does not need to duplicate it here.
HOMESCOUT_EXTRACT_API_KEY=

# ---------------------------------------------------------------------------
# The browser interface
# ---------------------------------------------------------------------------
# The loopback port it listens on. Default 8765. Worth changing to something uncommon if you run
# other things on this machine.
HOMESCOUT_PORT=

# Names this will answer to besides 127.0.0.1 and localhost, comma separated, port optional. Empty
# by default, and it should stay empty unless you have put a reverse proxy on this machine in front
# of the interface, which is how you reach it from a phone. See docs/tailscale.md.
#
# This is a list rather than a switch on purpose: a name that is not here is still refused, which is
# what stops a domain that resolves to 127.0.0.1 from reading your data. It adds no authentication,
# because there is none, so whatever can reach the proxy can use the interface.
HOMESCOUT_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# The browser interface's map
# ---------------------------------------------------------------------------
# Optional, and empty by default on purpose: asking a tile server for tiles tells that server which
# part of the world you are looking at, and this tool's only outbound traffic is otherwise to
# listing sites, public data services, an optional model and your mail server. Drawing areas works
# without a background.
HOMESCOUT_MAP_TILES=
HOMESCOUT_MAP_ATTRIBUTION=
